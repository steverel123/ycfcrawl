# Supabase project: cqnjlcosmjzuquaczmav
# Copy to .env and fill in secrets (never commit .env)

# API (Project Settings → API) — required for upload_to_supabase.py
SUPABASE_URL=https://cqnjlcosmjzuquaczmav.supabase.co
# Dashboard → Project Settings → API → service_role (required for upload_to_supabase.py)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Session pooler eu-west-1 — copy full URI from Dashboard → Database → Connection string → Session pooler
DATABASE_URL=postgresql://postgres.cqnjlcosmjzuquaczmav:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Storage bucket (create in Dashboard → Storage, set Public)
SUPABASE_STORAGE_BUCKET=yacht-images

# RunPod shell (interactive only — cannot upload files)
RUNPOD_SSH=your-pod-id@ssh.runpod.io
SSH_KEY=~/.ssh/id_ed25519

# Required for upload/download — Pod → Connect → Direct TCP Ports (e.g. 69.x.x.x:25634 -> :22)
RUNPOD_DIRECT_HOST=
RUNPOD_DIRECT_PORT=
# RunPod API (Settings → API Keys) — required for RunPod MCP + REST
RUNPOD_API_KEY=your_runpod_api_key

# Upload tuning (optional): SYNC_PARALLEL=20 for faster parallel rsync
